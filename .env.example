# All optional. The dashboard is built into vigil-collector and talks to
# whichever collector serves it, so no API URLs are needed.

# Branding shown in the navbar and browser tab.
VITE_APP_NAME="Vigil"
VITE_APP_TITLE="System Monitor"

# Optional labels shown as chips in the navbar and footer.
VITE_DEPLOY_REGION=
VITE_DEPLOY_INSTANCE=

# "websocket" for live data (default) or "http" for a static snapshot.
VITE_CONNECTION_TYPE="websocket"

# ``npm run dev`` only: the collector the dev server proxies API calls to.
VIGIL_COLLECTOR_URL="http://127.0.0.1:4500"
