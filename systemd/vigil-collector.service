[Unit]
Description=Vigil - System Monitoring Utility
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<user>
Group=<group>
ExecStart=/usr/local/bin/vigil-collector --port=4700 --address=0.0.0.0
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
